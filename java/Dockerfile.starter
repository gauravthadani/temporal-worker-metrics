# Multi-stage build for the Temporal starter
ARG GRADLE_VERSION=8.8
ARG JDK_VERSION=17

FROM gradle:${GRADLE_VERSION}-jdk${JDK_VERSION} AS builder
WORKDIR /app
COPY settings.gradle.kts build.gradle.kts ./
COPY src ./src
RUN gradle --no-daemon starterJar

FROM eclipse-temurin:${JDK_VERSION}-jre
WORKDIR /app
COPY --from=builder /app/build/libs/starter.jar /app/starter.jar
ENTRYPOINT ["java", "-jar", "/app/starter.jar"]
