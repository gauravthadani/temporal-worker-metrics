# Multi-stage build for the Temporal worker
ARG GRADLE_VERSION=8.8
ARG JDK_VERSION=17

FROM gradle:${GRADLE_VERSION}-jdk${JDK_VERSION} AS builder
WORKDIR /app
COPY settings.gradle.kts build.gradle.kts ./
COPY src ./src
RUN gradle --no-daemon shadowJar

FROM eclipse-temurin:${JDK_VERSION}-jre
WORKDIR /app
COPY --from=builder /app/build/libs/worker.jar /app/worker.jar
ENTRYPOINT ["java", "-jar", "/app/worker.jar"]
